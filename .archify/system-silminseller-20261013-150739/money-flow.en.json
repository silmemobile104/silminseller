    {
      "dot": "amber",
      "title": "Where cash lines come from",
      "items": [
        "A plain cash sale writes no CashMovement; revenue comes from the bill",
        "Financing writes the immediate cash and a receivable",
        "Delivering a deposit also creates a cash-sale bill",
        "PO payments and vouchers each add an expense line to CashMovement"
      ]
    },
